{
    "defwidget@terminal": {
        "display:order": -5,
        "icon": "square-terminal",
        "label": "terminal",
        "blockdef": {
            "meta": {
                "view": "term",
                "controller": "shell"
            }
        }
    },
    "defwidget@agent": {
        "display:order": -4,
        "icon": "robot",
        "label": "agent",
        "description": "Start default agent in current workspace",
        "blockdef": {
            "meta": {
                "view": "term",
                "controller": "cmd",
                "cmd": "codex"
            }
        }
    },
    "defwidget@files": {
        "display:order": -3,
        "icon": "folder",
        "label": "files",
        "blockdef": {
            "meta": {
                "view": "preview",
                "file": "~"
            }
        }
    },
    "defwidget@web": {
        "display:order": -2,
        "icon": "globe",
        "label": "web",
        "blockdef": {
            "meta": {
                "view": "web"
            }
        }
    },
    "defwidget@sysinfo": {
        "display:order": -1,
        "icon": "chart-line",
        "label": "sysinfo",
        "blockdef": {
            "meta": {
                "view": "sysinfo"
            }
        }
    },
    "defwidget@processviewer": {
        "display:order": 0,
        "icon": "list-tree",
        "label": "processes",
        "blockdef": {
            "meta": {
                "view": "processviewer"
            }
        }
    }
}

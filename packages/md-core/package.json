{
    "name": "@snorkeling/md-core",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Host-agnostic markdown core: remark pipeline, block model, DOM<->markdown transform, react renderers. Zero static host imports; host capabilities are injected through MdHostAdapter.",
    "license": "Apache-2.0",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./*": "./src/*"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "hast": "^1.0.0",
        "mdast": "^3.0.0",
        "parse-srcset": "^1.0.2",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-markdown": "^9.0.3",
        "rehype-sanitize": "^6.0.0",
        "remark": "^15.0.1",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-stringify": "^11.0.0",
        "tailwind-merge": "^3.5.0",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.1.0",
        "vfile": "^6.0.3"
    }
}
